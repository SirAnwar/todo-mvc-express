<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ToDo</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <div class="card">

        <header class="header">
            <h1>ToDo List</h1>
            <span class="count">
                <%= todos.filter(todo=> todo.completed).length %>/<%= todos.length %> done
            </span>
        </header>

        <ul class="list">
            <% todos.forEach(todo => { %>
                <li class="item <%= todo.completed ? 'completed' : '' %>">
                    <input type="checkbox" <%= todo.completed ? 'checked' : '' %>>
                    <span class="title"><%= todo.title %></span>

                    <% if (todo.dueDate) { %>
                        <span class="date">
                            <i class="fa-regular fa-calendar"></i>
                            <%= todo.dueDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %>
                        </span>
                    <% } %>

                    <a href="#" class="icon"><i class="fa-regular fa-pen-to-square"></i></a>
                    <form action="#" method="POST">
                        <button class="icon delete"><i class="fa-regular fa-trash-can"></i></button>
                    </form>
                </li>
            <% }) %>
        </ul>

        <form class="add-form" action="#" method="POST">
            <input type="text" name="title" placeholder="What needs to be done?" required>
            <input type="date" name="dueDate">
            <button>+ Add</button>
        </form>

    </div>

</body>

</html>